  "worked_example": "def product_of_others(nums):\n    result = [1]*len(nums); product = 1\n    for i, x in enumerate(nums): result[i] = product; product *= x\n    product = 1\n    for i in range(len(nums)-1, -1, -1): result[i] *= product; product *= nums[i]\n    return result\n",
