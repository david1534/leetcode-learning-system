* text=auto
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Preserve learner artifacts byte-for-byte. Historical records include CRLF;
# normalizing them on checkout makes a fresh clone appear to have unsaved work.
progress/** -text
solutions/** -text
reflections/** -text
attempt/** -text
**/.gitkeep text eol=lf
